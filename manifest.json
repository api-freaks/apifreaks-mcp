{
  "manifest_version": "0.2",
  "name": "@apifreaks/mcp",
  "version": "1.1.1",
  "description": "The official MCP server for APIFreaks — real-time Weather, WHOIS, DNS, SSL, IP intelligence, currency, domain checks, screenshots, and more.",
  "author": {
    "name": "Umar Asad <umar@apifreaks.com>"
  },
  "homepage": "https://apifreaks.com/integrations/mcp-server",
  "license": "Apache-2.0",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/dist/index.js"
      ],
      "env": {
        "APIFREAKS_API_KEY": "${config.apiKey}"
      }
    }
  },
  "configSchema": {
    "type": "object",
    "required": ["apiKey"],
    "properties": {
      "apiKey": {
        "type": "string",
        "title": "APIFreaks API Key",
        "description": "Your APIFreaks API key. Get one free at apifreaks.com."
      }
    }
  },
  "tools_generated": true
}
